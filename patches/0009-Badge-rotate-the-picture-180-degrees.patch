From 98cdbc7978e5f90dded3c829eb684086d3265eca Mon Sep 17 00:00:00 2001
From: TokyoDanInJapan <254110859+TokyoDanInJapan@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:03:14 +0900
Subject: [PATCH 9/9] Badge: rotate the picture 180 degrees

BADGE_SCREEN_ROTATED (default 1) turns the ST7789 output round and flips
the tilt, strafe and menu up/down directions to match, since the badge
is then held the other way round.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 platform/rp2350/game/platform.c | 14 +++++++++++++-
 platform/rp2350/qservice.c      |  4 ++++
 platform/rp2350/qservice.h      |  8 ++++++++
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/platform/rp2350/game/platform.c b/platform/rp2350/game/platform.c
index a72e9a1..c992320 100644
--- a/platform/rp2350/game/platform.c
+++ b/platform/rp2350/game/platform.c
@@ -32,7 +32,7 @@ void IN_Commands(void){}
  *
  * In game:  tilt forward/back = walk, tilt left/right = turn,
  *           DOWN = fire, UP = jump, SELECT = next weapon (hold it to open the menu),
- *           LEFT/RIGHT = strafe right/left, HOME = menu.
+ *           LEFT/RIGHT = strafe, HOME = menu.
  * In menus: the buttons are arrows, SELECT = enter (hold it to close the menu),
  *           HOME = back.
  *
@@ -41,10 +41,17 @@ void IN_Commands(void){}
  * asks you to hold the badge comfortably and press SELECT. That position
  * becomes "level" for tilt.
  *
+ * BADGE_SCREEN_ROTATED (qservice.h) rotates the picture 180 degrees and flips
+ * the tilt, strafe and menu up/down directions to match.
  * If a tilt direction feels reversed, flip its sign here.
  */
+#if BADGE_SCREEN_ROTATED
+#define BADGE_TILT_FORWARD_SIGN  1.0f
+#define BADGE_TILT_TURN_SIGN     1.0f
+#else
 #define BADGE_TILT_FORWARD_SIGN -1.0f
 #define BADGE_TILT_TURN_SIGN    -1.0f
+#endif
 #define BADGE_TILT_DEADZONE_DEG  6.0f
 #define BADGE_TILT_FULL_DEG     25.0f
 #define BADGE_MAX_FORWARD      320.0f   /* units/s; walk is 200, run is 400 */
@@ -136,8 +143,13 @@ void IN_Move(usercmd_t *cmd){
 
 void Sys_SendKeyEvents(void){
     /* Bit order matches QSERVICE_BADGE_*: UP, DOWN, LEFT, RIGHT, SELECT, HOME. */
+#if BADGE_SCREEN_ROTATED
+    static const int game_keys[QSERVICE_BADGE_BUTTONS]={K_SPACE,K_CTRL,'a','d','v',K_ESCAPE};
+    static const int menu_keys[QSERVICE_BADGE_BUTTONS]={K_UPARROW,K_DOWNARROW,K_LEFTARROW,K_RIGHTARROW,K_ENTER,K_ESCAPE};
+#else
     static const int game_keys[QSERVICE_BADGE_BUTTONS]={K_SPACE,K_CTRL,'d','a','v',K_ESCAPE};
     static const int menu_keys[QSERVICE_BADGE_BUTTONS]={K_DOWNARROW,K_UPARROW,K_LEFTARROW,K_RIGHTARROW,K_ENTER,K_ESCAPE};
+#endif
     static uint16_t previous;static int held_key[QSERVICE_BADGE_BUTTONS];
     uint16_t now=qservice_buttons(),pressed=qservice_buttons_pressed();
     for(unsigned i=0;i<QSERVICE_BADGE_BUTTONS;i++){
diff --git a/platform/rp2350/qservice.c b/platform/rp2350/qservice.c
index 66db184..21ec1cd 100644
--- a/platform/rp2350/qservice.c
+++ b/platform/rp2350/qservice.c
@@ -348,7 +348,11 @@ static void worker(void) {
     audio_lock_number=spin_lock_claim_unused(true);
     audio_lock=spin_lock_instance(audio_lock_number);
 
+#if defined(UNIVERSE_BADGE) && BADGE_SCREEN_ROTATED
+    st7789_init(320,240,ST7789_ROTATE_180,false,ST7789_COLOR_RGB565);
+#else
     st7789_init(320,240,ST7789_ROTATE_0,false,ST7789_COLOR_RGB565);
+#endif
     st7789_set_backlight(0);
     memset(lcd_row0,0,sizeof lcd_row0);
     st7789_set_window(0,0,320,240);
diff --git a/platform/rp2350/qservice.h b/platform/rp2350/qservice.h
index 85156da..ad3da05 100644
--- a/platform/rp2350/qservice.h
+++ b/platform/rp2350/qservice.h
@@ -21,6 +21,14 @@ enum {
 bool qservice_accel(int16_t out[3]);
 /* True if the IMU is configured; *failures counts failed I2C transfers. */
 bool qservice_imu_status(uint32_t *failures);
+
+/*
+ * Badge orientation. 1 = picture rotated 180 degrees, so the badge is held the
+ * other way round; the tilt, strafe and menu up/down directions follow it.
+ */
+#ifndef BADGE_SCREEN_ROTATED
+#define BADGE_SCREEN_ROTATED 1
+#endif
 /* Mixer mutations are synchronized with core 1 using the same shared-mixer
  * spin-lock model as p8. PCM or QAD1 source bytes must remain valid while
  * active; production QAD1 data is immutable XIP and is decoded on core 1. */
-- 
