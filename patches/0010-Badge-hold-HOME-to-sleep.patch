 /* True if the IMU is configured; *failures counts failed I2C transfers. */
 bool qservice_imu_status(uint32_t *failures);
+/* Badge only: screen and motion sensor off until a front button is pressed. Blocks core 0 until then. */
+void qservice_sleep(void);
 
