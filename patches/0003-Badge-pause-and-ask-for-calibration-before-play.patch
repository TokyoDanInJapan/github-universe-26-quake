From 84c258fbe13592697370666af93cc6b9ab46be30 Mon Sep 17 00:00:00 2001
From: TokyoDanInJapan <254110859+TokyoDanInJapan@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:03:14 +0900
Subject: [PATCH 3/9] Badge: pause and ask for calibration before play

At start and whenever the menu closes, the server is paused and a
prompt asks the player to hold the badge comfortably and press SELECT.
That position becomes level for tilt. The on-screen tilt status line
is off; it still goes to USB serial.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 platform/rp2350/game/platform.c | 51 ++++++++++++++++++++++++---------
 1 file changed, 38 insertions(+), 13 deletions(-)

diff --git a/platform/rp2350/game/platform.c b/platform/rp2350/game/platform.c
index 7aab162..35c4b42 100644
--- a/platform/rp2350/game/platform.c
+++ b/platform/rp2350/game/platform.c
@@ -35,8 +35,9 @@ void IN_Commands(void){}
  *           LEFT/RIGHT = strafe, HOME = menu.
  * In menus: the buttons are arrows, SELECT = enter, HOME = back.
  *
- * "Level" is however you hold the badge when the game starts, and it is
- * captured again each time you close the menu.
+ * Before play starts, and each time the menu closes, the game pauses and
+ * asks you to hold the badge comfortably and press SELECT. That position
+ * becomes "level" for tilt.
  *
  * If a tilt direction feels reversed, flip its sign here.
  */
@@ -51,12 +52,30 @@ void IN_Commands(void){}
 
 static float tilt_x,tilt_y,tilt_z,level_pitch,level_roll;
 static bool tilt_have_sample,tilt_have_level;
-static double tilt_first_sample;
 static keydest_t tilt_last_dest=key_game;
+/* Calibration: the game is paused until SELECT is pressed. */
+static volatile bool calibrating,calibrate_confirmed;
+extern float scr_centertime_off;
 
 static float tilt_pitch(void){return atan2f(tilt_y,tilt_z)*BADGE_RAD2DEG;}
 static float tilt_roll(void){return atan2f(tilt_x,sqrtf(tilt_y*tilt_y+tilt_z*tilt_z))*BADGE_RAD2DEG;}
-static void tilt_set_level(void){level_pitch=tilt_pitch();level_roll=tilt_roll();tilt_have_level=true;Con_Printf("Tilt level set\n");}
+static void tilt_set_level(void){level_pitch=tilt_pitch();level_roll=tilt_roll();tilt_have_level=true;}
+
+static void calibrate_start(void){calibrating=true;calibrate_confirmed=false;sv.paused=true;}
+
+/* Runs every frame while calibrating. Returns true once SELECT has been pressed. */
+static bool calibrate_step(void){
+    if(!calibrate_confirmed){
+        sv.paused=true;
+        SCR_CenterPrint("Hold the badge comfortably\nand press SELECT to start");
+        return false;
+    }
+    tilt_set_level();
+    calibrating=false;calibrate_confirmed=false;
+    sv.paused=false;
+    scr_centertime_off=0;
+    return true;
+}
 
 /* Maps an angle offset to -1..1 with a dead zone and a gentle curve. */
 static float tilt_axis(float degrees){
@@ -69,7 +88,8 @@ static float tilt_axis(float degrees){
 }
 
 /* Set to 0 to hide the tilt status line once tilt works. */
-#define BADGE_TILT_DEBUG 1
+#define BADGE_TILT_DEBUG 1          /* status line on USB serial */
+#define BADGE_TILT_DEBUG_SCREEN 0   /* also show it on screen for 30 s */
 
 static void tilt_debug(bool have,const int16_t *a,float forward,float turn){
 #if BADGE_TILT_DEBUG
@@ -82,7 +102,7 @@ static void tilt_debug(bool have,const int16_t *a,float forward,float turn){
     if(have)snprintf(line,sizeof line,"imu ok=%d err=%lu a=%d %d %d fwd=%d turn=%d",ok,(unsigned long)failures,a[0],a[1],a[2],(int)(forward*100),(int)(turn*100));
     else snprintf(line,sizeof line,"imu ok=%d err=%lu no data",ok,(unsigned long)failures);
     printf("%s\n",line);
-    if(now-start<30.0)Con_Printf("%s\n",line);
+    if(BADGE_TILT_DEBUG_SCREEN && now-start<30.0)Con_Printf("%s\n",line);
 #else
     (void)have;(void)a;(void)forward;(void)turn;
 #endif
@@ -91,13 +111,13 @@ static void tilt_debug(bool have,const int16_t *a,float forward,float turn){
 void IN_Move(usercmd_t *cmd){
     int16_t a[3];
     if(!qservice_accel(a)){tilt_debug(false,a,0,0);return;}
-    if(!tilt_have_sample){tilt_x=a[0];tilt_y=a[1];tilt_z=a[2];tilt_have_sample=true;tilt_first_sample=Sys_FloatTime();}
+    if(!tilt_have_sample){tilt_x=a[0];tilt_y=a[1];tilt_z=a[2];tilt_have_sample=true;}
     tilt_x+=(a[0]-tilt_x)*BADGE_FILTER;tilt_y+=(a[1]-tilt_y)*BADGE_FILTER;tilt_z+=(a[2]-tilt_z)*BADGE_FILTER;
 
     keydest_t dest=key_dest,previous=tilt_last_dest;tilt_last_dest=dest;
     if(dest!=key_game)return;
-    if(previous==key_menu)tilt_set_level();
-    if(!tilt_have_level){if(Sys_FloatTime()-tilt_first_sample>=1.0)tilt_set_level();tilt_debug(true,a,0,0);return;}
+    if((!tilt_have_level || previous==key_menu) && !calibrating)calibrate_start();
+    if(calibrating && !calibrate_step()){tilt_debug(true,a,0,0);return;}
 
     float dp=tilt_pitch()-level_pitch;
     if(dp>180.0f)dp-=360.0f;else if(dp<-180.0f)dp+=360.0f;
@@ -117,13 +137,18 @@ void Sys_SendKeyEvents(void){
     uint16_t now=qservice_buttons(),pressed=qservice_buttons_pressed();
     for(unsigned i=0;i<QSERVICE_BADGE_BUTTONS;i++){
         unsigned mask=1u<<i;
-        int key=(key_dest==key_game?game_keys:menu_keys)[i];
+        bool in_game=key_dest==key_game;
+        int key=(in_game?game_keys:menu_keys)[i];
+        /* While calibrating, SELECT confirms and other buttons except HOME do nothing. */
+        bool swallow=in_game && calibrating && i!=QSERVICE_BADGE_HOME;
+        bool press=((now^previous)&mask)?(now&mask)!=0:((pressed&mask) && !(now&mask));
+        if(swallow && press && i==QSERVICE_BADGE_SELECT)calibrate_confirmed=true;
         if((now^previous)&mask){
             /* Release the same key that was pressed, even if the menu opened in between. */
-            if(now&mask){held_key[i]=key;Key_Event(key,true);}
-            else Key_Event(held_key[i],false);
+            if(now&mask){held_key[i]=swallow?0:key;if(!swallow)Key_Event(key,true);}
+            else if(held_key[i]){Key_Event(held_key[i],false);held_key[i]=0;}
         }
-        else if((pressed&mask) && !(now&mask)){Key_Event(key,true);Key_Event(key,false);}
+        else if(press && !swallow){Key_Event(key,true);Key_Event(key,false);}
     }
     previous=now;
 }
-- 
