+/* Badge button bits returned by qservice_buttons() on UNIVERSE_BADGE builds. */
+enum {
+    QSERVICE_BADGE_UP,QSERVICE_BADGE_DOWN,QSERVICE_BADGE_LEFT,
+    QSERVICE_BADGE_RIGHT,QSERVICE_BADGE_SELECT,QSERVICE_BADGE_HOME,
+    QSERVICE_BADGE_BUTTONS
