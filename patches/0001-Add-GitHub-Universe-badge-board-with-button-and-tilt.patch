+/*
+ * Board definition for the GitHub Universe 2026 badge
+ * (custom Pimoroni Tufty 2350, USB ID 2e8a:1101).
+ *
+ * Pins were read from the badge's own MicroPython firmware (machine.Pin.board).
+ * The LCD wiring is the same as the Pimoroni Explorer.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef _BOARDS_UNIVERSE_BADGE_H
+#define _BOARDS_UNIVERSE_BADGE_H
+
+pico_board_cmake_set(PICO_PLATFORM, rp2350)
+
+#ifndef UNIVERSE_BADGE
+#define UNIVERSE_BADGE 1
+#endif
+
+/* 80-GPIO RP2350B package. */
+#define PICO_RP2350A 0
+
+/* LCD: ST7789 on an 8-bit parallel bus (same pins as the Explorer). */
+#define UNIVERSE_BADGE_LCD_BACKLIGHT_PIN 26
+#define UNIVERSE_BADGE_LCD_CS_PIN        27
+#define UNIVERSE_BADGE_LCD_RS_PIN        28
+#define UNIVERSE_BADGE_LCD_WR_PIN        30
+#define UNIVERSE_BADGE_LCD_RD_PIN        31
+#define UNIVERSE_BADGE_LCD_DB0_PIN       32
+
+/* Front buttons. All are active low and need the internal pull-up. */
+#define UNIVERSE_BADGE_BUTTON_DOWN_PIN   6
+#define UNIVERSE_BADGE_BUTTON_LEFT_PIN   7
+#define UNIVERSE_BADGE_BUTTON_RIGHT_PIN  9
+#define UNIVERSE_BADGE_BUTTON_SELECT_PIN 10
+#define UNIVERSE_BADGE_BUTTON_UP_PIN     11
+#define UNIVERSE_BADGE_BUTTON_HOME_PIN   22
+
+/* Internal I2C bus (i2c1): LSM6DS3TR-C IMU at 0x6a, CAP1208 touch at 0x28. */
+#define UNIVERSE_BADGE_INT_I2C_SDA_PIN   18
+#define UNIVERSE_BADGE_INT_I2C_SCL_PIN   19
+#define UNIVERSE_BADGE_IMU_ADDRESS       0x6a
+
+/* Battery power latch. Must be driven high or the badge turns off on battery. */
+#define UNIVERSE_BADGE_POWER_EN_PIN      41
+
+/*
+ * Pins this firmware must leave alone:
+ *   12 VBUS_DETECT (input), 13 CAP_ALERT (input), 20 IMU_INT,
+ *   23-25/29 Wi-Fi module, 4/5 Qwiic bus, 16/17 IR.
+ * The badge has no speaker, so the Explorer's PWM audio on GPIO12/13 is not used.
+ */
+
+#ifndef PICO_DEFAULT_LED_PIN
+#define PICO_DEFAULT_LED_PIN UNIVERSE_BADGE_LCD_BACKLIGHT_PIN
+#endif
+#ifndef PICO_DEFAULT_LED_PIN_INVERTED
+#define PICO_DEFAULT_LED_PIN_INVERTED 0
+#endif
+
+/* 16 MB QSPI flash. The badge's own firmware reports boot2_w25q080. */
+#define PICO_BOOT_STAGE2_CHOOSE_W25Q080 1
+#ifndef PICO_FLASH_SPI_CLKDIV
+#define PICO_FLASH_SPI_CLKDIV 2
+#endif
+pico_board_cmake_set_default(PICO_FLASH_SIZE_BYTES, (16 * 1024 * 1024))
+#ifndef PICO_FLASH_SIZE_BYTES
+#define PICO_FLASH_SIZE_BYTES (16 * 1024 * 1024)
+#endif
+
+pico_board_cmake_set_default(PICO_RP2350_A2_SUPPORTED, 1)
+#ifndef PICO_RP2350_A2_SUPPORTED
+#define PICO_RP2350_A2_SUPPORTED 1
+#endif
+
+#endif
