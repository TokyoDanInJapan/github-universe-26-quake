--- a/platform/rp2350/qservice.h
+++ b/platform/rp2350/qservice.h
@@ -11,6 +11,14 @@ uint8_t *qservice_frame_acquire(unsigned *slot);
 void qservice_frame_submit(unsigned slot,const uint8_t palette[768]);
